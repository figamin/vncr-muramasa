# Copy to .env and fill in. .env is gitignored, so real values stay out of the
# repository; keep them there, not here.

# IGDB API credentials (for game logging)
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret
IGDB_ACCESS_TOKEN=your_igdb_access_token

# Web console login (HTTP Basic Auth).
# The console refuses to start unless WEB_CONSOLE_PASSWORD is set.
WEB_CONSOLE_USERNAME=admin
WEB_CONSOLE_PASSWORD=generate_a_strong_random_value

# Address the web console is published on. Keep it private; 127.0.0.1 is local only.
CONSOLE_BIND_IP=127.0.0.1

# Passwords of the Anki Leaderboard groups that /ankileaderboard tells members to join.
ANKI_LEADERBOARD_PASSWORD=
SAKURA_ANKI_LEADERBOARD_PASSWORD=

# Lets the web console's Hikaru tab start/restart Hikaru as a local process, using
# external_databases.hikaru.control in config.json. Only needed when Hikaru is not
# managed by Docker; the Docker control path does not read this.
ALLOW_LOCAL_HIKARU_SPAWN=1

# MyAnimeList link for the anime bot (/mal link). The app's Client ID is built in, and an
# admin enters the Client Secret in Discord with /manage_mal, so these are optional: set
# them only to use a different MAL app (https://myanimelist.net/apiconfig).
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost/
# AniList link (anime bot): the AniList API client ID is built into
# sub-bots/anime-bot/overrides/anilist.py; set this only to use a different client.
ANILIST_CLIENT_ID=
